{
  "collectionName": "components_content_presss",
  "info": {
    "displayName": "press"
  },
  "attributes": {
    "url": {
      "type": "string",
      "required": true,
      "regex": "^https?://[^\\s/]+(?:[/?#][^\\s]*)?$"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": true
    }
  }
}
